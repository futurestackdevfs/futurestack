generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum Role {
  STUDENT
  TRAINER
  COORDINATOR
  SUPPORT
  ADMIN
  CONTENT_MANAGER
  SALES
}

enum Currency {
  INR
  USD
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUND_REQUESTED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  REJECTED
}

enum GatewayType {
  DOMESTIC
  INTERNATIONAL
}

enum DiscountType {
  PERCENT
  FLAT
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  companyId            String?   @unique
  name                 String
  password             String?
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  passwordExpiresAt    DateTime?
  // Bumped on every password change. Any refresh token issued before this
  // instant, and any access token with iat before it, is rejected — so a
  // password reset immediately logs out all existing sessions without
  // deleting rows. See AuthService.resetPassword / JwtStrategy.
  passwordChangedAt    DateTime?
  googleId             String?   @unique
  role                 Role      @default(STUDENT)
  isActive             Boolean   @default(true)
  mustChangePassword   Boolean   @default(false)
  avatarUrl            String?
  emailVerified        Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  lastLoginAt          DateTime?

  // Flag to coordinator
  flaggedToCoordinator Boolean @default(false)
  flagReason           String?

  // Extended profile fields (nullable — students + trainers both use these)
  bio           String?
  phone         String?
  dob           DateTime?
  city          String?
  qualification String?
  experience    SkillLevel?
  careerPath    String?
  skills        String[]    @default([])

  // Trainer-only profile fields (nullable — only populated for TRAINER role)
  yearsExperience     Int?
  rating              Float?
  trainerSharePercent Int? // per-trainer override (% trainer keeps); null = use global PaymentSettings default
  // Set once the trainer completes the required-fields onboarding form (first
  // login gate). Null = onboarding not done yet — the trainer console shows
  // the onboarding wizard instead of the portal. Independent of approvalStatus:
  // a trainer can be logged in and mid-review while already having submitted.
  profileSubmittedAt DateTime?

  enrollments       Enrollment[]
  videoProgress     VideoProgress[]
  quizAttempts      QuizAttempt[] // ADDED — fixes missing back-relation
  coursesTaught     Course[]           @relation("CourseTrainer")
  projectsTaught    Project[]          @relation("ProjectTrainer")
  approvalStatus    ApprovalStatus?
  certificates      Certificate[]

  discussionMessages CourseDiscussion[]      @relation("DiscussionAuthor")
  discussionReplies  CourseDiscussionReply[] @relation("ReplyAuthor")
  discussionUpvotes  DiscussionUpvote[]

  revenueLedger RevenueLedger[] @relation("TrainerLedger")
  payouts       Payout[]        @relation("TrainerPayouts")
  refreshTokens RefreshToken[]

  reviewsGiven Review[] @relation("StudentReviews")

  cart             Cart?
  wishlist         Wishlist?
  orders           Order[]
  salesOrders      Order[]       @relation("OrderSalesperson")
  leads            Lead[]        @relation("LeadSalesperson")
  leadAsStudent    Lead[]        @relation("LeadStudent")
  salesTargets     SalesTarget[] @relation("SalesTargets")
  invoices         Invoice[]     @relation("Invoices")
  refundsInitiated Refund[]      @relation("RefundInitiator")
  refunds          Refund[]      @relation("RefundStudent")

  supportTickets  SupportTicket[]        @relation("TicketAuthor")
  assignedTickets SupportTicket[]        @relation("TicketAssignee")
  supportMessages SupportTicketMessage[]
}

model Track {
  id           String        @id @default(uuid())
  title        String
  description  String?
  isSequential Boolean       @default(false)
  isFeatured   Boolean       @default(false)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  courses      TrackCourse[]
}

model Course {
  id               String       @id @default(uuid())
  title            String       @unique
  description      String?
  thumbnailUrl     String?
  price            Decimal      @db.Decimal(10, 2)
  originalPrice    Decimal?     @db.Decimal(10, 2) // list/strikethrough price (admin-set). null = no discount, display price only.
  priceUsd         Decimal?     @db.Decimal(10, 2) // USD sale price for international checkout. null = auto-convert from `price` via PaymentSettings.usdRate.
  originalPriceUsd Decimal?     @db.Decimal(10, 2) // USD list/strikethrough price. null = no USD discount shown.
  status           CourseStatus @default(DRAFT)
  isFeatured       Boolean      @default(false)
  displayOrder     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  trainerId String?
  trainer   User?   @relation("CourseTrainer", fields: [trainerId], references: [id])

  // Overview tab content
  whatYoullLearn String[]    @default([]) // bullet list, e.g. ["Build production-grade apps", ...]
  techStack      String[]    @default([]) // chips, e.g. ["MongoDB", "React.js", "Docker"]
  careerTitle    String? // e.g. "High-demand skill — average salary ₹18L–₹40L/yr"
  careerBody     String? // longer paragraph
  category       String? // e.g. "Web Development"
  code           String?     @unique // internal course code
  skillLevel     SkillLevel?

  sections     Section[]
  enrollments  Enrollment[]
  tracks       TrackCourse[]
  resources    CourseResource[]
  discussions  CourseDiscussion[]
  certificates Certificate[]
  reviews      Review[]

  averageRating Float @default(0)
  reviewCount   Int   @default(0)

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  salesTargets  SalesTarget[]
  refunds       Refund[]
}

model CourseResource {
  id            String   @id @default(uuid())
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId      String
  title         String   @unique // e.g. "MERN Stack Cheat Sheet"
  fileType      String // "PDF" | "ZIP" | "FIGMA" | "PPT" — free text, frontend maps to icon
  fileUrl       String // S3 url, or external link (Figma/GitHub)
  fileSizeLabel String? // e.g. "4.2 MB" — display-only, not computed
  createdAt     DateTime @default(now())
}

model TrackCourse {
  id         String @id @default(uuid())
  track      Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId    String
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  orderIndex Int?

  @@unique([trackId, courseId])
}

model Section {
  id       String @id @default(uuid())
  title    String @unique
  order    Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  videos  Video[]
  quizzes Quiz[]
}

model Video {
  id              String          @id @default(uuid())
  title           String
  vdoCipherId     String
  durationSeconds Int
  order           Int
  isPreview       Boolean         @default(false)
  videoStatus     VideoStatus     @default(UPLOADING)
  section         Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId       String
  progress        VideoProgress[]
}

model Quiz {
  id             String        @id @default(uuid())
  title          String
  order          Int // same ordering convention as Video.order within a Section
  section        Section?      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId      String? // null = standalone quiz/skill test, not attached to a course section
  totalQuestions Int
  passingScore   Int? // percentage, e.g. 70 — null means no pass/fail gate
  attempts       QuizAttempt[]
  questions      QuizQuestion[]
}

model QuizQuestion {
  id           String  @id @default(uuid())
  quiz         Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId       String
  question     String
  options      String[]
  correctIndex Int
  explanation  String?
  order        Int
}

model QuizAttempt {
  id             String   @id @default(uuid())
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId         String
  score          Int // percentage, e.g. 91
  totalQuestions Int?
  correctCount   Int?
  isPassed       Boolean?
  answers        Json?
  isCompleted    Boolean  @default(true) // a submitted attempt is complete by definition
  completedAt    DateTime @default(now())

  @@index([studentId])
  @@index([quizId])
}

model Enrollment {
  id         String   @id @default(uuid())
  student    User     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentId  String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  amountPaid Decimal  @db.Decimal(10, 2)
  enrolledAt DateTime @default(now())
  status     String   @default("active")

  revenueLedger RevenueLedger?
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id])

  @@unique([studentId, courseId])
}

model VideoProgress {
  id                       String                  @id @default(uuid())
  student                  User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId                String
  video                    Video?                  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId                  String?
  projectVideo             ProjectCurriculumVideo? @relation(fields: [projectCurriculumVideoId], references: [id], onDelete: Cascade)
  projectCurriculumVideoId String?
  uniqueSecsWatched        Int                     @default(0)
  lastPositionSec          Int                     @default(0)
  isCompleted              Boolean                 @default(false)
  completedAt              DateTime?
  updatedAt                DateTime                @updatedAt
  score                    Int?

  @@unique([studentId, videoId])
  @@unique([studentId, projectCurriculumVideoId])
}

enum MessageTag {
  DOUBT
  TIP
  ANNOUNCEMENT
  RESOURCE
}

model CourseDiscussion {
  id            String                  @id @default(uuid())
  course        Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId      String
  author        User                    @relation("DiscussionAuthor", fields: [authorId], references: [id])
  authorId      String
  body          String
  tag           MessageTag              @default(DOUBT)
  isPinned      Boolean                 @default(false)
  isAnswered    Boolean                 @default(false)
  attachmentUrl String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @default(now()) @updatedAt
  replies       CourseDiscussionReply[]
  upvotes       DiscussionUpvote[]
}

model CourseDiscussionReply {
  id        String             @id @default(uuid())
  message   CourseDiscussion   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  author    User               @relation("ReplyAuthor", fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  upvotes   DiscussionUpvote[]
}

model DiscussionUpvote {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  messageId String?
  replyId   String?
  createdAt DateTime @default(now())

  message CourseDiscussion?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reply   CourseDiscussionReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@unique([userId, replyId])
}

model Certificate {
  id           String   @id @default(uuid())
  student      User     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentId    String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  credentialId String   @unique
  score        Int?
  rank         Int?
  issuedAt     DateTime @default(now())

  @@unique([studentId, courseId])
}

model RevenueLedger {
  id           String     @id @default(uuid())
  trainer      User       @relation("TrainerLedger", fields: [trainerId], references: [id])
  trainerId    String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  enrollmentId String     @unique
  gross        Decimal    @db.Decimal(10, 2)
  platformCut  Decimal    @db.Decimal(10, 2)
  trainerShare Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
}

model Payout {
  id        String   @id @default(uuid())
  trainer   User     @relation("TrainerPayouts", fields: [trainerId], references: [id])
  trainerId String
  amount    Decimal  @db.Decimal(10, 2)
  period    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

/// Append-only trail of privileged staff actions across the admin surface
/// (coupons, payments/refunds, payment settings, enrolments, course price /
/// publish state, trainer approval & revenue share, homepage CMS, …).
/// Rows are only ever INSERTed — never updated or deleted from application code.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorRole  String
  actorEmail String?
  actorName  String? // denormalized — stays readable even if the admin is later deleted
  action     String // CREATE | UPDATE | DELETE | APPROVE | REJECT | REFUND | DEACTIVATE
  entityType String? // Coupon | Course | Enrollment | Refund | PaymentSettings | Trainer | Staff | HeroSlide | Track
  entityId   String?
  changes    Json? // { before?, after?, requested? } — changed fields only
  meta       Json? // free-form extra context (reason, amount, …)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Review {
  id      String  @id @default(uuid())
  rating  Int
  comment String?

  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  student   User   @relation("StudentReviews", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, studentId])
  @@unique([projectId, studentId])
}

model HeroSlide {
  id           String   @id @default(uuid())
  title        String
  imageUrl     String
  linkUrl      String?
  isFeatured   Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  items     CartItem[]
  couponId  String?
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
  addedAt   DateTime @default(now())

  @@unique([cartId, courseId])
  @@unique([cartId, projectId])
}

model Wishlist {
  id     String         @id @default(uuid())
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String         @unique
  items  WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  wishlistId String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  addedAt    DateTime @default(now())

  @@unique([wishlistId, courseId])
}

model Coupon {
  id                  String       @id @default(uuid())
  code                String       @unique
  discountType        DiscountType
  value               Decimal      @db.Decimal(10, 2)
  currency            Currency?
  applicableCourseIds String[]     @default([])
  minOrderAmount      Decimal?     @db.Decimal(10, 2)
  maxUses             Int?
  usedCount           Int          @default(0)
  perUserLimit        Int          @default(1)
  isActive            Boolean      @default(true)
  validFrom           DateTime?
  validUntil          DateTime?
  createdByAdminId    String
  createdAt           DateTime     @default(now())

  redemptions CouponRedemption[]
  carts       Cart[]
}

model CouponRedemption {
  id        String   @id @default(uuid())
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  couponId  String
  userId    String
  orderId   String   @unique
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}

model Order {
  id                String       @id @default(uuid())
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId            String
  currency          Currency
  gatewayType       GatewayType
  subtotal          Decimal      @db.Decimal(10, 2)
  discountAmount    Decimal      @default(0) @db.Decimal(10, 2)
  couponId          String?
  gstPercent        Decimal      @default(0) @db.Decimal(10, 4) // GST rate snapshot at purchase time (admin-configurable in PaymentSettings)
  gstAmount         Decimal      @default(0) @db.Decimal(10, 2) // GST amount charged on top of (subtotal - discount)
  totalAmount       Decimal      @db.Decimal(10, 2)
  status            OrderStatus  @default(CREATED)
  razorpayOrderId   String       @unique
  razorpayPaymentId String?
  razorpaySignature String?
  paymentMethod     String?
  isInternational   Boolean? // set from the Razorpay payment entity — was the card foreign-issued?
  settledCurrency   String? // currency the payment actually settled in, per Razorpay ("INR" | "USD")
  billingFullName   String?
  billingEmail      String?
  billingPhone      String?
  billingAddress    String?
  billingCity       String?
  billingState      String?
  billingPincode    String?
  billingCountry    String? // ISO 3166-1 alpha-2, e.g. "IN", "US". Drives currency + invoice format.
  batchMode         String? // "Online" | "Offline" — set by the sales console for manually collected sales
  discountReason    String? // salesperson notes for a manual discount
  items             OrderItem[]
  enrollments       Enrollment[]
  leads             Lead[]
  invoices          Invoice[]
  refunds           Refund[]
  salesperson       User?        @relation("OrderSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  salespersonId     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model OrderItem {
  id              String   @id @default(uuid())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  course          Course?  @relation(fields: [courseId], references: [id])
  courseId        String?
  project         Project? @relation(fields: [projectId], references: [id])
  projectId       String?
  priceAtPurchase Decimal  @db.Decimal(10, 2)
  currency        Currency
  status          String? // for projects: pending | active | refunded

  @@index([courseId])
  @@index([projectId])
}

/// Singleton — controls which payment gateways/currencies are available at
/// checkout. Admin toggles via PATCH /admin/payment-settings. The frontend
/// reads the public projection to hide/disable disabled currencies.
model PaymentSettings {
  id                   String   @id @default(uuid())
  domesticEnabled      Boolean  @default(true) // INR (domestic gateway)
  internationalEnabled Boolean  @default(false) // USD (international gateway)
  trainerSharePercent  Int      @default(50) // default % of collected gross the trainer keeps (rest = platform cut)
  gstPercent           Decimal  @default(18) @db.Decimal(10, 4) // GST % charged on top of every course fee (INR / domestic)
  gstPercentUsd        Decimal  @default(0) @db.Decimal(10, 4) // GST % for USD orders — export of services is zero-rated by default
  usdRate              Decimal  @default(95) @db.Decimal(10, 4) // INR per 1 USD — fallback conversion when a course/project has no explicit priceUsd. Fresh rows are seeded from the DEFAULT_USD_RATE env var; this DB default is only a raw safety net. Admin edits the live value.
  updatedAt            DateTime @updatedAt
}

model LegalPage {
  id        String   @id @default(uuid())
  slug      String   @unique // "terms" | "refund-policy" | "cookie-policy" | "sitemap"
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

model JobPosting {
  id          String   @id @default(uuid())
  title       String
  duration    String // e.g. "Full-time", "3-month internship", "Contract — 6 months"
  description String?  @db.Text
  createdAt   DateTime @default(now())
}

model Lead {
  id           String    @id @default(uuid())
  name         String
  email        String?
  phone        String?
  city         String?
  course       String? // course interest (free text or from course list)
  status       String    @default("New") // "New" | "Interested" | "Converted" | "Dropped"
  budget       Decimal   @default(0) @db.Decimal(10, 2)
  score        Int       @default(35)
  source       String? // e.g. Website, Referral, Walk-in, Demo
  notes        String? // salesperson notes / follow-up context
  nextFollowUp DateTime?
  lastContact  DateTime?

  salesperson   User?   @relation("LeadSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  salespersonId String?
  student       User?   @relation("LeadStudent", fields: [studentId], references: [id], onDelete: SetNull)
  studentId     String?
  order         Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId       String?

  followUps LeadFollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salespersonId])
  @@index([status])
}

model LeadFollowUp {
  id          String    @id @default(uuid())
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String
  action      String // "scheduled" | "rescheduled" | "completed" | "converted" | "dropped"
  note        String?
  scheduledAt DateTime? // the follow-up time this entry refers to
  createdAt   DateTime  @default(now())

  @@index([leadId])
}

// ─── LIVE PROJECTS ─────────────────────────────────────────────────

model Project {
  id                  String       @id @default(uuid())
  name                String       @unique
  image               String?
  techLabel           String       @default("")
  tech                String       @default("")
  shortDesc           String       @default("")
  overview            String       @default("")
  thumbGradient       String       @default("linear-gradient(135deg,#0d1f3c,#0a2a1a)")
  level               SkillLevel?
  badge               String       @default("")
  duration            String       @default("")
  sessions            String       @default("")
  seats               Int          @default(0)
  price               Decimal      @default(0) @db.Decimal(10, 2)
  originalPrice       Decimal?     @db.Decimal(10, 2)
  priceUsd            Decimal?     @db.Decimal(10, 2) // USD sale price for international checkout. null = auto-convert from `price` via PaymentSettings.usdRate.
  originalPriceUsd    Decimal?     @db.Decimal(10, 2) // USD list/strikethrough price. null = no USD discount shown.
  rating              Float        @default(0)
  reviewCount         Int          @default(0)
  status              CourseStatus @default(DRAFT)
  isFeatured          Boolean      @default(false)
  displayOrder        Int          @default(0)
  category            String?
  stack               String[]     @default([])
  highlights          String[]     @default([])
  prereqs             String[]     @default([])
  includes            String[]     @default([])
  industryUse         String       @default("")
  tools               String[]     @default([])
  setupSteps          String[]     @default([])
  demoVideoUrl        String?
  walkthroughVideoUrl String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  trainerId String?
  trainer   User?   @relation("ProjectTrainer", fields: [trainerId], references: [id])

  curriculum ProjectCurriculum[]
  orderItems OrderItem[]
  reviews    Review[]
  cartItems  CartItem[]
  refunds    Refund[]
}

model ProjectCurriculum {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  week      String
  title     String
  desc      String
  order     Int

  videos ProjectCurriculumVideo[]

  @@index([projectId])
}

model ProjectCurriculumVideo {
  id              String            @id @default(uuid())
  curriculumId    String
  curriculum      ProjectCurriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  title           String
  vdoCipherId     String?
  durationSeconds Int               @default(0)
  videoStatus     VideoStatus       @default(UPLOADING)
  isPreview       Boolean           @default(false)
  order           Int
  progress        VideoProgress[]

  @@index([curriculumId])
}

// ─── SALES TARGETS ──────────────────────────────────────────────────

model SalesTarget {
  id            String   @id @default(uuid())
  salespersonId String
  salesperson   User     @relation("SalesTargets", fields: [salespersonId], references: [id], onDelete: Cascade)
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  period        String // "monthly" | "quarterly" | "yearly"
  targetAmount  Decimal  @default(0) @db.Decimal(10, 2)
  currentAmount Decimal  @default(0) @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([salespersonId])
}

// ─── INVOICES ───────────────────────────────────────────────────────

model Invoice {
  id              String    @id @default(uuid())
  invoiceNumber   String    @unique
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation("Invoices", fields: [userId], references: [id], onDelete: Restrict)
  subtotal        Decimal   @db.Decimal(10, 2)
  gstPercent      Decimal   @default(0) @db.Decimal(10, 4)
  gstAmount       Decimal   @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal   @db.Decimal(10, 2)
  billingFullName String?
  billingEmail    String?
  billingPhone    String?
  billingAddress  String?
  billingCity     String?
  billingState    String?
  billingPincode  String?
  issuedAt        DateTime  @default(now())
  dueAt           DateTime?

  @@index([orderId])
  @@index([userId])
}

// ─── REFUNDS ─────────────────────────────────────────────────────

model Refund {
  id               String       @id @default(uuid())
  order            Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String?
  student          User         @relation("RefundStudent", fields: [studentId], references: [id], onDelete: Restrict)
  studentId        String
  course           Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId         String?
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId        String?
  amount           Decimal      @db.Decimal(10, 2)
  reason           String
  status           RefundStatus @default(PENDING)
  razorpayRefundId String?
  initiatedBy      User         @relation("RefundInitiator", fields: [initiatedById], references: [id], onDelete: Restrict)
  initiatedById    String
  processedAt      DateTime?
  createdAt        DateTime     @default(now())

  @@index([orderId])
  @@index([studentId])
  @@index([status])
}

// ─── BLOG ───────────────────────────────────────────────────────────

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String    @db.Text
  metaDescription String
  tags            String[]
  sourceTopic     String?
  status          String    @default("draft")
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
}

// ─── Support / help-desk tickets ─────────────────────────────────────

enum TicketStatus {
  OPEN // waiting on an agent
  PENDING // waiting on the student
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  PAYMENT
  REFUND
  COURSE_ACCESS
  VIDEO
  CERTIFICATE
  ACCOUNT
  BUG
  LIVE_SESSION
  OTHER
}

model SupportTicket {
  id       String         @id @default(uuid())
  number   Int            @unique @default(autoincrement()) // human ref: SUP-0XXXX
  subject  String
  category TicketCategory
  topic    String? // sub-topic id chosen in the guided wizard
  context  Json? // { orderId?, courseId?, lessonId?, browser? }
  priority TicketPriority @default(NORMAL)
  status   TicketStatus   @default(OPEN)

  student    User    @relation("TicketAuthor", fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime  @default(now())
  resolvedAt    DateTime?
  closedAt      DateTime?

  messages SupportTicketMessage[]

  @@index([status])
  @@index([assigneeId])
  @@index([studentId])
  @@index([lastMessageAt])
}

model SupportTicketMessage {
  id             String        @id @default(uuid())
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId       String
  author         User          @relation(fields: [authorId], references: [id])
  authorId       String
  body           String
  attachmentUrl  String?
  isInternalNote Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([ticketId])
}
