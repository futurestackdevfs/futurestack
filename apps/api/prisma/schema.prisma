generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum Role {
  STUDENT
  TRAINER
  COORDINATOR
  SUPPORT
  ADMIN
  CONTENT_MANAGER
}

enum Currency {
  INR
  USD
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum GatewayType {
  DOMESTIC
  INTERNATIONAL
}

enum DiscountType {
  PERCENT
  FLAT
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  name                 String
  password             String?
  passwordResetToken   String?         @unique
  passwordResetExpires DateTime?
  googleId             String?         @unique
  role                 Role            @default(STUDENT)
  isActive             Boolean         @default(true)
  avatarUrl            String?
  emailVerified        Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  lastLoginAt          DateTime?

  // Extended profile fields (nullable — students + trainers both use these)
  bio                  String?
  phone                String?
  dob                  DateTime?
  city                 String?
  qualification        String?
  experience           SkillLevel?
  careerPath           String?
  skills               String[]      @default([])

  // Trainer-only profile fields (nullable — only populated for TRAINER role)
  yearsExperience      Int?
  rating               Float?
  trainerSharePercent  Int?      // per-trainer override (% trainer keeps); null = use global PaymentSettings default

  enrollments          Enrollment[]
  videoProgress        VideoProgress[]
  quizAttempts         QuizAttempt[]              // ADDED — fixes missing back-relation
  coursesTaught        Course[]        @relation("CourseTrainer")
  approvalStatus       ApprovalStatus?
  certificates         Certificate[]

  discussionMessages  CourseDiscussion[]       @relation("DiscussionAuthor")
  discussionReplies   CourseDiscussionReply[]  @relation("ReplyAuthor")
  discussionUpvotes   DiscussionUpvote[]

  revenueLedger       RevenueLedger[] @relation("TrainerLedger")
  payouts             Payout[]        @relation("TrainerPayouts")
  refreshTokens       RefreshToken[]

  reviewsGiven        Review[]        @relation("StudentReviews")

  cart               Cart?
  wishlist           Wishlist?
  orders             Order[]
}

model Track {
  id           String        @id @default(uuid())
  title        String
  description  String?
  isSequential Boolean       @default(false)
  isFeatured   Boolean       @default(false)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  courses      TrackCourse[]
}

model Course {
  id           String        @id @default(uuid())
  title        String     @unique
  description  String?
  thumbnailUrl String?
  price        Float
  status       CourseStatus  @default(DRAFT)
  isFeatured   Boolean       @default(false)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())

  trainerId    String?
  trainer      User?         @relation("CourseTrainer", fields: [trainerId], references: [id])

  // Overview tab content
  whatYoullLearn String[]    @default([])  // bullet list, e.g. ["Build production-grade apps", ...]
  techStack      String[]    @default([])  // chips, e.g. ["MongoDB", "React.js", "Docker"]
  careerTitle    String?                    // e.g. "High-demand skill — average salary ₹18L–₹40L/yr"
  careerBody     String?                    // longer paragraph
  category       String?                    // e.g. "Web Development"
  code           String?     @unique        // internal course code
  skillLevel     SkillLevel?

  sections     Section[]
  enrollments  Enrollment[]
  tracks       TrackCourse[]
  resources    CourseResource[]
  discussions  CourseDiscussion[]
  certificates Certificate[]
  reviews      Review[]
  
  averageRating Float @default(0)
  reviewCount   Int   @default(0)

  coursePrices    CoursePrice[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
}

model CourseResource {
  id            String   @id @default(uuid())
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId      String
    title        String     @unique                       // e.g. "MERN Stack Cheat Sheet"
  fileType      String                       // "PDF" | "ZIP" | "FIGMA" | "PPT" — free text, frontend maps to icon
  fileUrl       String                       // S3 url, or external link (Figma/GitHub)
  fileSizeLabel String?                      // e.g. "4.2 MB" — display-only, not computed
  createdAt     DateTime @default(now())
}

model TrackCourse {
  id         String  @id @default(uuid())
  track      Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId    String
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  orderIndex Int?

  @@unique([trackId, courseId])
}

model Section {
  id       String  @id @default(uuid())
  title        String     @unique
  order    Int
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  videos   Video[]
  quizzes  Quiz[]
}

model Video {
  id              String          @id @default(uuid())
  title           String
  vdoCipherId     String
  durationSeconds Int
  order           Int
  isPreview       Boolean         @default(false)
  videoStatus     VideoStatus     @default(UPLOADING)
  section         Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId       String
  progress        VideoProgress[]
}

model Quiz {
  id             String        @id @default(uuid())
  title          String
  order          Int                          // same ordering convention as Video.order within a Section
  section        Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId      String
  totalQuestions Int
  passingScore   Int?                         // percentage, e.g. 70 — null means no pass/fail gate
  attempts       QuizAttempt[]
}

model QuizAttempt {
  id          String   @id @default(uuid())
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId      String
  score       Int                              // percentage, e.g. 91
  isCompleted Boolean  @default(true)           // a submitted attempt is complete by definition
  completedAt DateTime @default(now())

  @@unique([studentId, quizId])  // one attempt record per student per quiz (latest/best — your call on retake policy)
}

model Enrollment {
  id         String   @id @default(uuid())
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  amountPaid Float
  enrolledAt DateTime @default(now())
  status     String   @default("active")
  
  revenueLedger RevenueLedger?
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id])

  @@unique([studentId, courseId])
}

model VideoProgress {
  id                String    @id @default(uuid())
  student           User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId         String
  video             Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId           String
  uniqueSecsWatched Int       @default(0)
  lastPositionSec   Int       @default(0)
  isCompleted       Boolean   @default(false)
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt
  score             Int?                       // optional post-video check score, null if none exists

  @@unique([studentId, videoId])
}

enum MessageTag {
  DOUBT
  TIP
  ANNOUNCEMENT
  RESOURCE
}

model CourseDiscussion {
  id            String        @id @default(uuid())
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId      String
  author        User          @relation("DiscussionAuthor", fields: [authorId], references: [id])
  authorId      String
  body          String
  tag           MessageTag    @default(DOUBT)
  isPinned      Boolean       @default(false)
  isAnswered    Boolean       @default(false)
  attachmentUrl String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  replies       CourseDiscussionReply[]
  upvotes       DiscussionUpvote[]
}

model CourseDiscussionReply {
  id        String          @id @default(uuid())
  message   CourseDiscussion @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  author    User            @relation("ReplyAuthor", fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  upvotes   DiscussionUpvote[]
}

model DiscussionUpvote {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  messageId String?
  replyId   String?
  createdAt DateTime @default(now())

  message   CourseDiscussion?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reply     CourseDiscussionReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@unique([userId, replyId])
}

model Certificate {
  id           String   @id @default(uuid())
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  credentialId String   @unique
  score        Int?
  rank         Int?
  issuedAt     DateTime @default(now())

  @@unique([studentId, courseId])
}

model RevenueLedger {
  id           String     @id @default(uuid())
  trainer      User       @relation("TrainerLedger", fields: [trainerId], references: [id])
  trainerId    String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  enrollmentId String     @unique
  gross        Float
  platformCut  Float
  trainerShare Float
  createdAt    DateTime   @default(now())
}

model Payout {
  id        String   @id @default(uuid())
  trainer   User     @relation("TrainerPayouts", fields: [trainerId], references: [id])
  trainerId String
  amount    Float
  period    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  
  student   User     @relation("StudentReviews", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, studentId])
}

model HeroSlide {
  id           String   @id @default(uuid())
  title        String
  imageUrl     String
  linkUrl      String?
  isFeatured   Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CoursePrice {
  id       String   @id @default(uuid())
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  currency Currency
  amount   Float

  @@unique([courseId, currency])
}

model Cart {
  id        String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  items     CartItem[]
  couponId  String?
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id       String   @id @default(uuid())
  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId   String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  addedAt  DateTime @default(now())

  @@unique([cartId, courseId])
}

model Wishlist {
  id     String         @id @default(uuid())
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String         @unique
  items  WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  wishlistId String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  addedAt    DateTime @default(now())

  @@unique([wishlistId, courseId])
}

model Coupon {
  id                   String       @id @default(uuid())
  code                 String       @unique
  discountType         DiscountType
  value                Float
  currency             Currency?
  applicableCourseIds  String[]     @default([])
  minOrderAmount       Float?
  maxUses              Int?
  usedCount            Int          @default(0)
  perUserLimit         Int          @default(1)
  isActive             Boolean      @default(true)
  validFrom            DateTime?
  validUntil           DateTime?
  createdByAdminId     String
  createdAt            DateTime     @default(now())

  redemptions          CouponRedemption[]
  carts                Cart[]
}

model CouponRedemption {
  id        String   @id @default(uuid())
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  couponId  String
  userId    String
  orderId   String   @unique
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}

model Order {
  id                String      @id @default(uuid())
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  currency          Currency
  gatewayType       GatewayType
  subtotal          Float
  discountAmount    Float       @default(0)
  couponId          String?
  gstPercent        Float       @default(0)  // GST rate snapshot at purchase time (admin-configurable in PaymentSettings)
  gstAmount         Float       @default(0)  // GST amount charged on top of (subtotal - discount)
  totalAmount       Float
  status            OrderStatus @default(CREATED)
  razorpayOrderId   String      @unique
  razorpayPaymentId String?
  razorpaySignature String?
  paymentMethod     String?
  billingFullName   String?
  billingEmail      String?
  billingPhone      String?
  billingAddress    String?
  billingCity       String?
  billingState      String?
  billingPincode    String?
  items             OrderItem[]
  enrollments       Enrollment[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id              String   @id @default(uuid())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  course          Course   @relation(fields: [courseId], references: [id])
  courseId        String
  priceAtPurchase Float
  currency        Currency
}

/// Singleton — controls which payment gateways/currencies are available at
/// checkout. Admin toggles via PATCH /admin/payment-settings. The frontend
/// reads the public projection to hide/disable disabled currencies.
model PaymentSettings {
  id                   String   @id @default(uuid())
  domesticEnabled      Boolean  @default(true)   // INR (domestic gateway)
  internationalEnabled Boolean  @default(false)  // USD (international gateway)
  trainerSharePercent  Int      @default(50)     // default % of collected gross the trainer keeps (rest = platform cut)
  gstPercent           Float    @default(18)     // GST % charged on top of every course fee
  updatedAt            DateTime @updatedAt
}

