generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum Role {
  STUDENT
  TRAINER
  COORDINATOR
  SUPPORT
  ADMIN
  CONTENT_MANAGER
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  name                 String
  password             String?
  passwordResetToken   String?         @unique
  passwordResetExpires DateTime?
  googleId             String?         @unique
  role                 Role            @default(STUDENT)
  isActive             Boolean         @default(true)
  avatarUrl            String?
  emailVerified        Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  lastLoginAt          DateTime?

  // Trainer-only profile fields (nullable — only populated for TRAINER role)
  bio                  String?
  yearsExperience      Int?
  rating               Float?

  enrollments          Enrollment[]
  videoProgress        VideoProgress[]
  quizAttempts         QuizAttempt[]              // ADDED — fixes missing back-relation
  coursesTaught        Course[]        @relation("CourseTrainer")
  approvalStatus       ApprovalStatus?
}

model Track {
  id           String        @id @default(uuid())
  title        String
  description  String?
  isSequential Boolean       @default(false)
  isFeatured   Boolean       @default(false)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  courses      TrackCourse[]
}

model Course {
  id           String        @id @default(uuid())
  title        String
  description  String?
  thumbnailUrl String?
  price        Float
  status       CourseStatus  @default(DRAFT)
  isFeatured   Boolean       @default(false)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())

  trainerId    String?
  trainer      User?         @relation("CourseTrainer", fields: [trainerId], references: [id])

  // Overview tab content
  whatYoullLearn String[]    @default([])  // bullet list, e.g. ["Build production-grade apps", ...]
  techStack      String[]    @default([])  // chips, e.g. ["MongoDB", "React.js", "Docker"]
  careerTitle    String?                    // e.g. "High-demand skill — average salary ₹18L–₹40L/yr"
  careerBody     String?                    // longer paragraph

  sections     Section[]
  enrollments  Enrollment[]
  tracks       TrackCourse[]
  resources    CourseResource[]
}

model CourseResource {
  id            String   @id @default(uuid())
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId      String
  title         String                       // e.g. "MERN Stack Cheat Sheet"
  fileType      String                       // "PDF" | "ZIP" | "FIGMA" | "PPT" — free text, frontend maps to icon
  fileUrl       String                       // S3 url, or external link (Figma/GitHub)
  fileSizeLabel String?                      // e.g. "4.2 MB" — display-only, not computed
  createdAt     DateTime @default(now())
}

model TrackCourse {
  id         String  @id @default(uuid())
  track      Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId    String
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  orderIndex Int?

  @@unique([trackId, courseId])
}

model Section {
  id       String  @id @default(uuid())
  title    String
  order    Int
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  videos   Video[]
  quizzes  Quiz[]
}

model Video {
  id              String          @id @default(uuid())
  title           String
  vdoCipherId     String
  durationSeconds Int
  order           Int
  section         Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId       String
  progress        VideoProgress[]
}

model Quiz {
  id             String        @id @default(uuid())
  title          String
  order          Int                          // same ordering convention as Video.order within a Section
  section        Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId      String
  totalQuestions Int
  passingScore   Int?                         // percentage, e.g. 70 — null means no pass/fail gate
  attempts       QuizAttempt[]
}

model QuizAttempt {
  id          String   @id @default(uuid())
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId      String
  score       Int                              // percentage, e.g. 91
  isCompleted Boolean  @default(true)           // a submitted attempt is complete by definition
  completedAt DateTime @default(now())

  @@unique([studentId, quizId])  // one attempt record per student per quiz (latest/best — your call on retake policy)
}

model Enrollment {
  id         String   @id @default(uuid())
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  amountPaid Float
  enrolledAt DateTime @default(now())
  status     String   @default("active")

  @@unique([studentId, courseId])
}

model VideoProgress {
  id                String    @id @default(uuid())
  student           User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId         String
  video             Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId           String
  uniqueSecsWatched Int       @default(0)
  lastPositionSec   Int       @default(0)
  isCompleted       Boolean   @default(false)
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt
  score             Int?                       // optional post-video check score, null if none exists

  @@unique([studentId, videoId])
}
