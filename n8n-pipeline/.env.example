# n8n Pipeline Environment Variables
# These values must be set for the n8n pipeline to function correctly.

# Render service configuration
N8N_HOST=<your-render-url-without-protocol>
WEBHOOK_URL=https://<your-render-url>/

# n8n basic auth (enable for production)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=<choose-a-username>
N8N_BASIC_AUTH_PASSWORD=<choose-a-strong-password>

# API keys
GEMINI_API_KEY=<from ai.google.dev>

# FutureStack integration
FUTURESTACK_BLOG_API_KEY=<same value as backend's BLOG_INTERNAL_API_KEY>
FUTURESTACK_BACKEND_URL=<backend render URL>

# Optional: Webhook-specific
N8N_WEBHOOK_SECRET=<random-secret-for-webhook-verification>